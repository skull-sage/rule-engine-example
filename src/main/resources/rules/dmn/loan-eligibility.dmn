<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/"
             id="_loan_eligibility_definitions"
             name="LoanEligibility"
             namespace="https://example.com/dmn/loan-eligibility">

  <itemDefinition id="_it_age" name="tAge">
    <typeRef>number</typeRef>
  </itemDefinition>
  <itemDefinition id="_it_monthly_income" name="tMonthlyIncome">
    <typeRef>number</typeRef>
  </itemDefinition>
  <itemDefinition id="_it_credit_score" name="tCreditScore">
    <typeRef>number</typeRef>
  </itemDefinition>
  <itemDefinition id="_it_requested_amount" name="tRequestedAmount">
    <typeRef>number</typeRef>
  </itemDefinition>

  <itemDefinition id="_it_loan_decision" name="tLoanDecision">
    <itemComponent id="_it_ld_approved" name="approved">
      <typeRef>boolean</typeRef>
    </itemComponent>
    <itemComponent id="_it_ld_max_amount" name="maxApprovedAmount">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="_it_ld_risk_grade" name="riskGrade">
      <typeRef>string</typeRef>
    </itemComponent>
    <itemComponent id="_it_ld_interest_rate" name="interestRate">
      <typeRef>number</typeRef>
    </itemComponent>
    <itemComponent id="_it_ld_reason" name="reason">
      <typeRef>string</typeRef>
    </itemComponent>
  </itemDefinition>

  <inputData id="_id_age" name="age">
    <variable id="_var_age" name="age" typeRef="tAge"/>
  </inputData>
  <inputData id="_id_monthly_income" name="monthlyIncome">
    <variable id="_var_monthly_income" name="monthlyIncome" typeRef="tMonthlyIncome"/>
  </inputData>
  <inputData id="_id_credit_score" name="creditScore">
    <variable id="_var_credit_score" name="creditScore" typeRef="tCreditScore"/>
  </inputData>
  <inputData id="_id_requested_amount" name="requestedAmount">
    <variable id="_var_requested_amount" name="requestedAmount" typeRef="tRequestedAmount"/>
  </inputData>

  <decision id="_decision_loan_evaluation" name="Loan Eligibility Decision">
    <variable id="_var_loan_evaluation" name="Loan Eligibility Decision" typeRef="tLoanDecision"/>
    <informationRequirement id="_ir_age">
      <requiredInput href="#_id_age"/>
    </informationRequirement>
    <informationRequirement id="_ir_monthly_income">
      <requiredInput href="#_id_monthly_income"/>
    </informationRequirement>
    <informationRequirement id="_ir_credit_score">
      <requiredInput href="#_id_credit_score"/>
    </informationRequirement>
    <informationRequirement id="_ir_requested_amount">
      <requiredInput href="#_id_requested_amount"/>
    </informationRequirement>

    <decisionTable id="_dt_loan_evaluation" hitPolicy="FIRST" typeRef="tLoanDecision">
      <input id="_dt_in_age" label="Age">
        <inputExpression id="_dt_ie_age" typeRef="number">
          <text>age</text>
        </inputExpression>
      </input>
      <input id="_dt_in_monthly_income" label="Monthly Income">
        <inputExpression id="_dt_ie_monthly_income" typeRef="number">
          <text>monthlyIncome</text>
        </inputExpression>
      </input>
      <input id="_dt_in_credit_score" label="Credit Score">
        <inputExpression id="_dt_ie_credit_score" typeRef="number">
          <text>creditScore</text>
        </inputExpression>
      </input>
      <input id="_dt_in_requested_amount" label="Requested Amount">
        <inputExpression id="_dt_ie_requested_amount" typeRef="number">
          <text>requestedAmount</text>
        </inputExpression>
      </input>

      <output id="_dt_out_approved" name="approved" typeRef="boolean"/>
      <output id="_dt_out_max_amount" name="maxApprovedAmount" typeRef="number"/>
      <output id="_dt_out_risk_grade" name="riskGrade" typeRef="string"/>
      <output id="_dt_out_interest_rate" name="interestRate" typeRef="number"/>
      <output id="_dt_out_reason" name="reason" typeRef="string"/>

      <!-- Rule 1: Underage applicant -->
      <rule id="_r1">
        <inputEntry id="_r1_1"><text>&lt; 18</text></inputEntry>
        <inputEntry id="_r1_2"><text>-</text></inputEntry>
        <inputEntry id="_r1_3"><text>-</text></inputEntry>
        <inputEntry id="_r1_4"><text>-</text></inputEntry>
        <outputEntry id="_r1_out1"><text>false</text></outputEntry>
        <outputEntry id="_r1_out2"><text>0</text></outputEntry>
        <outputEntry id="_r1_out3"><text>"DECLINED"</text></outputEntry>
        <outputEntry id="_r1_out4"><text>0.0</text></outputEntry>
        <outputEntry id="_r1_out5"><text>"Applicant must be at least 18 years old"</text></outputEntry>
      </rule>

      <!-- Rule 2: Low Credit Score -->
      <rule id="_r2">
        <inputEntry id="_r2_1"><text>&gt;= 18</text></inputEntry>
        <inputEntry id="_r2_2"><text>-</text></inputEntry>
        <inputEntry id="_r2_3"><text>&lt; 580</text></inputEntry>
        <inputEntry id="_r2_4"><text>-</text></inputEntry>
        <outputEntry id="_r2_out1"><text>false</text></outputEntry>
        <outputEntry id="_r2_out2"><text>0</text></outputEntry>
        <outputEntry id="_r2_out3"><text>"DECLINED"</text></outputEntry>
        <outputEntry id="_r2_out4"><text>0.0</text></outputEntry>
        <outputEntry id="_r2_out5"><text>"Credit score below minimum requirement of 580"</text></outputEntry>
      </rule>

      <!-- Rule 3: Insufficient Income (< 25,000) -->
      <rule id="_r3">
        <inputEntry id="_r3_1"><text>&gt;= 18</text></inputEntry>
        <inputEntry id="_r3_2"><text>&lt; 25000</text></inputEntry>
        <inputEntry id="_r3_3"><text>&gt;= 580</text></inputEntry>
        <inputEntry id="_r3_4"><text>-</text></inputEntry>
        <outputEntry id="_r3_out1"><text>false</text></outputEntry>
        <outputEntry id="_r3_out2"><text>0</text></outputEntry>
        <outputEntry id="_r3_out3"><text>"DECLINED"</text></outputEntry>
        <outputEntry id="_r3_out4"><text>0.0</text></outputEntry>
        <outputEntry id="_r3_out5"><text>"Monthly income below minimum qualification of 25,000"</text></outputEntry>
      </rule>

      <!-- Rule 4: Prime Tier (Score >= 750, Income >= 60,000) -->
      <rule id="_r4">
        <inputEntry id="_r4_1"><text>&gt;= 21</text></inputEntry>
        <inputEntry id="_r4_2"><text>&gt;= 60000</text></inputEntry>
        <inputEntry id="_r4_3"><text>&gt;= 750</text></inputEntry>
        <inputEntry id="_r4_4"><text>&lt;= 500000</text></inputEntry>
        <outputEntry id="_r4_out1"><text>true</text></outputEntry>
        <outputEntry id="_r4_out2"><text>500000</text></outputEntry>
        <outputEntry id="_r4_out3"><text>"LOW_RISK"</text></outputEntry>
        <outputEntry id="_r4_out4"><text>6.5</text></outputEntry>
        <outputEntry id="_r4_out5"><text>"Prime Tier: Approved with lowest interest rate"</text></outputEntry>
      </rule>

      <!-- Rule 5: Standard Tier (Score >= 670, Income >= 40,000) -->
      <rule id="_r5">
        <inputEntry id="_r5_1"><text>&gt;= 18</text></inputEntry>
        <inputEntry id="_r5_2"><text>&gt;= 40000</text></inputEntry>
        <inputEntry id="_r5_3"><text>&gt;= 670</text></inputEntry>
        <inputEntry id="_r5_4"><text>&lt;= 250000</text></inputEntry>
        <outputEntry id="_r5_out1"><text>true</text></outputEntry>
        <outputEntry id="_r5_out2"><text>250000</text></outputEntry>
        <outputEntry id="_r5_out3"><text>"MEDIUM_RISK"</text></outputEntry>
        <outputEntry id="_r5_out4"><text>9.0</text></outputEntry>
        <outputEntry id="_r5_out5"><text>"Standard Tier: Approved"</text></outputEntry>
      </rule>

      <!-- Rule 6: Fair Tier (Score >= 580, Income >= 25,000) -->
      <rule id="_r6">
        <inputEntry id="_r6_1"><text>&gt;= 18</text></inputEntry>
        <inputEntry id="_r6_2"><text>&gt;= 25000</text></inputEntry>
        <inputEntry id="_r6_3"><text>&gt;= 580</text></inputEntry>
        <inputEntry id="_r6_4"><text>&lt;= 100000</text></inputEntry>
        <outputEntry id="_r6_out1"><text>true</text></outputEntry>
        <outputEntry id="_r6_out2"><text>100000</text></outputEntry>
        <outputEntry id="_r6_out3"><text>"HIGH_RISK"</text></outputEntry>
        <outputEntry id="_r6_out4"><text>13.5</text></outputEntry>
        <outputEntry id="_r6_out5"><text>"Fair Tier: Approved with capped limit and higher rate"</text></outputEntry>
      </rule>

      <!-- Rule 7: Default fallback (e.g. requested amount exceeds bracket limit) -->
      <rule id="_r7">
        <inputEntry id="_r7_1"><text>-</text></inputEntry>
        <inputEntry id="_r7_2"><text>-</text></inputEntry>
        <inputEntry id="_r7_3"><text>-</text></inputEntry>
        <inputEntry id="_r7_4"><text>-</text></inputEntry>
        <outputEntry id="_r7_out1"><text>false</text></outputEntry>
        <outputEntry id="_r7_out2"><text>0</text></outputEntry>
        <outputEntry id="_r7_out3"><text>"DECLINED"</text></outputEntry>
        <outputEntry id="_r7_out4"><text>0.0</text></outputEntry>
        <outputEntry id="_r7_out5"><text>"Requested amount exceeds maximum allowable limit for credit profile"</text></outputEntry>
      </rule>

    </decisionTable>
  </decision>

</definitions>

