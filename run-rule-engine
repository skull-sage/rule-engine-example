#!/usr/bin/env bash
# ==============================================================================
# Script: run-rule-engine
# Purpose: Start the Spring Boot Rule Engine Service (Drools & KIE DMN)
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

PORT=8080
FOREGROUND=false
FORCE_BUILD=false
PID_FILE="$SCRIPT_DIR/.rule-engine.pid"
LOG_FILE="$SCRIPT_DIR/rule-engine.log"

print_usage() {
    echo -e "${BOLD}Usage:${NC} ./run-rule-engine [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -p, --port <port>     Set HTTP port (default: 8080)"
    echo "  -f, --foreground      Run in foreground instead of background daemon"
    echo "  -b, --build           Force rebuild bootJar before starting"
    echo "  -h, --help            Show this help message"
    echo ""
}

# Parse flags
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -p|--port)
            PORT="$2"
            shift 2
            ;;
        -f|--foreground)
            FOREGROUND=true
            shift
            ;;
        -b|--build)
            FORCE_BUILD=true
            shift
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            print_usage
            exit 1
            ;;
    esac
done

# Check if port is already in use
EXISTING_PID=$(lsof -ti :"$PORT" 2>/dev/null || true)
if [[ -n "$EXISTING_PID" ]]; then
    echo -e "${YELLOW}Warning: A process is already listening on port $PORT (PID: $EXISTING_PID).${NC}"
    echo -e "Use ${BOLD}./stop-rule-engine -p $PORT${NC} to stop it first."
    exit 1
fi

# Locate or build runnable jar
JAR_FILE=$(find "$SCRIPT_DIR/build/libs" -name "rule-engine-example-*.jar" ! -name "*-plain.jar" 2>/dev/null | head -n 1 || true)

if [[ "$FORCE_BUILD" = true || -z "$JAR_FILE" || ! -f "$JAR_FILE" ]]; then
    echo -e "${BLUE}==>${NC} Building application executable JAR via Gradle..."
    ./gradlew bootJar -x test --quiet
    JAR_FILE=$(find "$SCRIPT_DIR/build/libs" -name "rule-engine-example-*.jar" ! -name "*-plain.jar" | head -n 1)
fi

if [[ -z "$JAR_FILE" || ! -f "$JAR_FILE" ]]; then
    echo -e "${RED}Error: Executable JAR could not be found or built in build/libs/.${NC}"
    exit 1
fi

JAVA_CMD="java"
if [[ -n "$JAVA_HOME" && -x "$JAVA_HOME/bin/java" ]]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
fi

JVM_OPTS=(
    "-Dserver.port=$PORT"
    "-Dspring.profiles.active=default"
    "-Xms256m"
    "-Xmx1024m"
)

if [[ "$FOREGROUND" = true ]]; then
    echo -e "${GREEN}==>${NC} Starting Rule Engine on port ${BOLD}$PORT${NC} in foreground..."
    exec "$JAVA_CMD" "${JVM_OPTS[@]}" -jar "$JAR_FILE"
fi

# Background daemon mode
echo -e "${BLUE}==>${NC} Launching Rule Engine Service on port ${BOLD}$PORT${NC}..."
nohup "$JAVA_CMD" "${JVM_OPTS[@]}" -jar "$JAR_FILE" > "$LOG_FILE" 2>&1 &
APP_PID=$!
echo "$APP_PID" > "$PID_FILE"

# Wait for service health check
echo -n "Waiting for service to become healthy"
MAX_RETRIES=40
RETRIES=0
STARTED=false

while [[ $RETRIES -lt $MAX_RETRIES ]]; do
    if ! kill -0 "$APP_PID" 2>/dev/null; then
        echo ""
        echo -e "${RED}Service process died unexpectedly on startup. Check $LOG_FILE:${NC}"
        tail -n 25 "$LOG_FILE"
        rm -f "$PID_FILE"
        exit 1
    fi

    HEALTH_STATUS=$(curl -s "http://localhost:$PORT/actuator/health" 2>/dev/null | grep -o '"status":"UP"' || true)
    if [[ -n "$HEALTH_STATUS" ]]; then
        STARTED=true
        break
    fi

    echo -n "."
    sleep 1
    ((RETRIES++))
done
echo ""

if [[ "$STARTED" = true ]]; then
    echo -e "${GREEN}${BOLD}✓ Rule Engine Service is UP and running!${NC}"
    echo -e "  • ${BOLD}PID:${NC}            $APP_PID"
    echo -e "  • ${BOLD}Port:${NC}           $PORT"
    echo -e "  • ${BOLD}Health Endpoint:${NC}http://localhost:$PORT/actuator/health"
    echo -e "  • ${BOLD}API Catalog:${NC}    http://localhost:$PORT/api"
    echo -e "  • ${BOLD}Log File:${NC}       $LOG_FILE"
    echo ""
    echo -e "Quick test:"
    echo -e "  ${BLUE}curl -s http://localhost:$PORT/api | jq .${NC}"
    echo ""
    echo -e "To stop the service:"
    echo -e "  ${BOLD}./stop-rule-engine -p $PORT${NC}"
else
    echo -e "${RED}Timed out waiting for Rule Engine to report healthy.${NC}"
    echo -e "Check logs at: ${BOLD}$LOG_FILE${NC}"
    tail -n 25 "$LOG_FILE"
    exit 1
fi
