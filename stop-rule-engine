#!/usr/bin/env bash
# ==============================================================================
# Script: stop-rule-engine
# Purpose: Stop the running Spring Boot Rule Engine Service
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

PORT=8080
FORCE=false
PID_FILE="$SCRIPT_DIR/.rule-engine.pid"

print_usage() {
    echo -e "${BOLD}Usage:${NC} ./stop-rule-engine [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -p, --port <port>     Port of the service to stop (default: 8080)"
    echo "  -f, --force           Force kill immediately (SIGKILL)"
    echo "  -h, --help            Show this help message"
    echo ""
}

# Parse flags
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -p|--port)
            PORT="$2"
            shift 2
            ;;
        -f|--force)
            FORCE=true
            shift
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            print_usage
            exit 1
            ;;
    esac
done

TARGET_PID=""

# 1. Try reading from PID file
if [[ -f "$PID_FILE" ]]; then
    SAVED_PID=$(cat "$PID_FILE" 2>/dev/null || true)
    if [[ -n "$SAVED_PID" ]] && kill -0 "$SAVED_PID" 2>/dev/null; then
        TARGET_PID="$SAVED_PID"
    fi
fi

# 2. If PID file empty or process not alive, check by port
if [[ -z "$TARGET_PID" ]]; then
    PORT_PID=$(lsof -ti :"$PORT" 2>/dev/null || true)
    if [[ -n "$PORT_PID" ]]; then
        TARGET_PID="$PORT_PID"
    fi
fi

if [[ -z "$TARGET_PID" ]]; then
    echo -e "${YELLOW}No running Rule Engine process found (checked port $PORT and $PID_FILE).${NC}"
    rm -f "$PID_FILE"
    exit 0
fi

echo -e "${BLUE}==>${NC} Stopping Rule Engine Service (PID: ${BOLD}$TARGET_PID${NC}, Port: ${BOLD}$PORT${NC})..."

if [[ "$FORCE" = true ]]; then
    echo -e "${YELLOW}Force terminating process (SIGKILL)...${NC}"
    kill -9 "$TARGET_PID" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo -e "${GREEN}${BOLD}✓ Service forcefully terminated.${NC}"
    exit 0
fi

# Send SIGTERM for graceful shutdown
kill -15 "$TARGET_PID" 2>/dev/null || true

# Wait for graceful exit
echo -n "Waiting for graceful shutdown"
WAIT_COUNT=0
MAX_WAIT=15

while kill -0 "$TARGET_PID" 2>/dev/null; do
    if [[ $WAIT_COUNT -ge $MAX_WAIT ]]; then
        echo ""
        echo -e "${YELLOW}Process did not terminate within $MAX_WAIT seconds. Escalating to SIGKILL...${NC}"
        kill -9 "$TARGET_PID" 2>/dev/null || true
        break
    fi
    echo -n "."
    sleep 1
    ((WAIT_COUNT++))
done
echo ""

rm -f "$PID_FILE"
echo -e "${GREEN}${BOLD}✓ Rule Engine Service has been successfully stopped.${NC}"
